
@model StudentAttendanceManagement.ViewModels.MarkAttendanceViewModel

@{
    ViewData["Title"] = "Mark Attendance";
}


<div class="attendance-mark-panel">
    <h4 class="mb-3">Mark Student Attendance</h4>

    <div asp-validation-summary="ModelOnly"
         class="text-danger mb-3"></div>

    <div class="student-details">
        <p><strong>Student Name</strong>@Model.StudentName</p>
        <p><strong>Roll Number</strong>@Model.RollNumber</p>
        <p><strong>Department</strong>@Model.DepartmentName</p>
        <p><strong>Year</strong>@Model.YearOfStudy</p>
    </div>

    <form asp-controller="Attendance"
          asp-action="Mark"
          method="post">

        <input type="hidden"
               asp-for="StudentId" />

        <label asp-for="AttendanceStatus" class="form-label">
            Attendance Status
        </label>
        <select asp-for="AttendanceStatus" class="form-select mb-2">
            <option value="">Select Status</option>
            <option value="Present">Present</option>
            <option value="Absent">Absent</option>
        </select>
        <span asp-validation-for="AttendanceStatus"
              class="text-danger d-block mb-3"></span>

        <button type="submit" class="btn btn-primary">
            Submit Attendance
        </button>
    </form>

    <a asp-controller="Attendance" asp-action="Index" class="btn btn-link mt-3 px-0">
        Back to Student List
    </a>
</div>