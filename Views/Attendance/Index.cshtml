@model StudentAttendanceManagement.ViewModels.AttendanceViewModel

@{
    ViewData["Title"] = "Student Attendance List";
}

<a asp-controller="Home" asp-action="Index" class="btn btn-link mt-3 px-0">
        Back to Dashboard
    </a>
<div class="container py-4">

    @if (TempData["SuccessMessage"] is string successMessage)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            @successMessage
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    @if (TempData["DuplicateAttendanceMessage"] is string duplicateMessage)
    {
        <div class="alert alert-warning alert-dismissible fade show" role="alert">
            <strong>Duplicate submission:</strong> @duplicateMessage
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <h4 class="mb-2">Students List</h4>
    <p class="text-muted">
        Select a department and year to view the corresponding students.
    </p>

    <!-- Department and year filters -->
    <div class="card shadow-sm mb-4">
        <div class="card-body">
            <form asp-controller="Attendance"
                  asp-action="Index"
                  method="get">

                <div class="row g-3 align-items-end">
                    <div class="col-md-5">
                        <label for="departmentName" class="form-label">
                            Department
                        </label>

                        <select id="departmentName"
                                name="departmentName"
                                class="form-select"
                                required>
                            <option value="">Select Department</option>

                            @foreach (var department in Model.Departments)
                            {
                                <option value="@department.Value"
                                        selected="@(Model.DepartmentName == department.Value)">
                                    @department.Text
                                </option>
                            }
                        </select>
                    </div>

                    <div class="col-md-4">
                        <label for="yearOfStudy" class="form-label">
                            Year
                        </label>

                        <select id="yearOfStudy"
                                name="yearOfStudy"
                                class="form-select"
                                required>
                            <option value="">Select Year</option>

                            @for (int year = 1; year <= 4; year++)
                            {
                                <option value="@year"
                                        selected="@(Model.YearOfStudy == year)">
                                    @(
                                        year == 1 ? "First Year" :
                                        year == 2 ? "Second Year" :
                                        year == 3 ? "Third Year" :
                                        "Fourth Year"
                                    )
                                </option>
                            }
                        </select>
                    </div>

                    <div class="col-md-3">
                        <button type="submit"
                                class="btn btn-primary w-100">
                            View Students
                        </button>
                    </div>
                </div>
            </form>
        </div>
    </div>

    <!-- Student list -->
    @if (!string.IsNullOrWhiteSpace(Model.DepartmentName)
        && Model.YearOfStudy.HasValue)
    {
        <h5 class="mb-3">
            Students — @Model.DepartmentName,
            @(
                Model.YearOfStudy == 1 ? "First Year" :
                Model.YearOfStudy == 2 ? "Second Year" :
                Model.YearOfStudy == 3 ? "Third Year" :
                "Fourth Year"
            )
        </h5>

        @if (Model.Students.Count == 0)
        {
            <div class="alert alert-info">
                No students found for the selected Department and Year.
            </div>
        }
        else
        {
            <div class="card shadow-sm">
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">
                        <thead class="table-light">
                            <tr>
                                <th>Student Name</th>
                                <th>Roll Number</th>
                                <th>Department</th>
                                <th>Year</th>
                                <th>Attendance Action</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var student in Model.Students)
                            {
                                <tr>
                                    <td>@student.StudentName</td>
                                    <td>@student.RollNumber</td>
                                    <td>@student.DepartmentName</td>
                                    <td>@student.YearOfStudy</td>
                                    <td>
                                        <a asp-controller="Attendance"
                                           asp-action="Mark"
                                           asp-route-studentId="@student.StudentId"
                                           class="btn btn-sm btn-outline-primary">
                                            Mark Attendance
                                        </a>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        }
    }

    
</div>
