@{
    ViewData["Title"] = "Dashboard";
}

<div class="container mt-5">
    

    <div class="card mt-4 p-4">
        <h5>Welcome, @User.Identity?.Name!</h5>

        <p>
            Today's Date:
            @DateTime.Today.ToString("dd MMMM yyyy")
        </p>
    </div>

    <div class="mt-4">
        <h5>Quick Actions</h5>

        <div class="dashboard-actions d-flex flex-column align-items-start">

    <p class=" mb-0 mt-2">
        Browse students by department and year, then record their attendance.
    </p>

    <form asp-controller="Attendance"
          asp-action="Index"
          method="get">
        <button class="btn btn-primary">
            Attendance Management
        </button>
    </form>

    

</div>
    </div>
</div>
