<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - StudentAttendanceManagement</title>
    <script type="importmap"></script>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/StudentAttendanceManagement.styles.css" asp-append-version="true" />
</head>
<body>
    <header class="site-header">

    <nav class="navbar navbar-expand-sm">
        <div class="container">
            <h1 class="site-title">Student Attendance Management</h1>

            @if (User.Identity?.IsAuthenticated == true&&
    !(ViewContext.RouteData.Values["controller"]?.ToString() == "Account" &&
      (ViewContext.RouteData.Values["action"]?.ToString() == "Login" ||
       ViewContext.RouteData.Values["action"]?.ToString() == "Signup")))
            {
                <div class="ms-auto d-flex align-items-center gap-3">
                    <h5 class="mb-0 text-white">
                        @User.Identity?.Name!
                    </h5>

                    <form asp-controller="Account"
                        asp-action="Logout"
                        method="post"
                        class="m-0">
                        <button type="submit" class="btn btn-danger text-white ml-3">
                            Logout
                        </button>
                    </form>
                </div>
            }
        </div>
    </nav>

    </header>
    <div class="container page-container">
        <main role="main" class="pb-4">
            @RenderBody()
        </main>
    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
